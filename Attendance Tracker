// Attendance Tracker
// Supports both Day-Based and Hour-Based Attendance

#include <stdio.h>

int main()
{
    int choice;
    float total, attended, attendance;
    char cont;

    printf("=====================================\n");
    printf("      ATTENDANCE TRACKER\n");
    printf("=====================================\n");

    for(int i = 0; i < 50; i++)
    {
        int required = 0;
        int canMiss = 0;

        printf("\nChoose Attendance Type:\n");
        printf("1. Day-Based Attendance\n");
        printf("2. Hour-Based Attendance\n");
        printf("Enter Choice: ");
        scanf("%d", &choice);

        if(choice == 1)
        {
            printf("\nEnter Total Class Days Conducted: ");
            scanf("%f", &total);

            printf("Enter Class Days Attended: ");
            scanf("%f", &attended);
        }
        else if(choice == 2)
        {
            printf("\nEnter Total Class Hours Conducted: ");
            scanf("%f", &total);

            printf("Enter Class Hours Attended: ");
            scanf("%f", &attended);
        }
        else
        {
            printf("\nInvalid Choice!\n");
            continue;
        }

        attendance = (attended / total) * 100;

        printf("\n=====================================\n");
        printf("Current Attendance = %.2f%%\n", attendance);
        printf("=====================================\n");

        if(attendance < 75)
        {
            while(((attended + required) / (total + required)) * 100 < 75)
            {
                required++;
            }

            printf("Status : BELOW 75%%\n");

            if(choice == 1)
            {
                printf("You need to attend the next %d day(s) to reach 75%%.\n", required);
            }
            else
            {
                printf("You need to attend the next %d hour(s) to reach 75%%.\n", required);
            }

            printf("\nAttendance Recovery Chart\n");
            printf("-------------------------------------\n");

            for(int x = 1; x <= required; x++)
            {
                float newAttendance;

                newAttendance =
                ((attended + x) / (total + x)) * 100;

                if(choice == 1)
                {
                    printf("After attending %d more day(s) : %.2f%%\n",
                           x,
                           newAttendance);
                }
                else
                {
                    printf("After attending %d more hour(s) : %.2f%%\n",
                           x,
                           newAttendance);
                }
            }
        }
        else
        {
            while((attended / (total + canMiss + 1)) * 100 >= 75)
            {
                canMiss++;
            }

            printf("Status : SAFE\n");

            if(choice == 1)
            {
                printf("You can miss %d more day(s) before falling below 75%%.\n",
                       canMiss);
            }
            else
            {
                printf("You can miss %d more hour(s) before falling below 75%%.\n",
                       canMiss);
            }

            printf("\nAttendance Drop Chart\n");
            printf("-------------------------------------\n");

            for(int x = 1; x <= canMiss; x++)
            {
                float newAttendance;

                newAttendance =
                (attended / (total + x)) * 100;

                if(choice == 1)
                {
                    printf("After missing %d day(s) : %.2f%%\n",
                           x,
                           newAttendance);
                }
                else
                {
                    printf("After missing %d hour(s) : %.2f%%\n",
                           x,
                           newAttendance);
                }
            }
        }

        printf("\nDo you want to continue? (Y/N): ");
        scanf(" %c", &cont);

        if(cont == 'N' || cont == 'n')
        {
            break;
        }
    }

    printf("\n=====================================\n");
    printf("Thank You For Using Attendance Tracker\n");
    printf("=====================================\n");

    return 0;
}
